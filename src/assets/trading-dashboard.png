<svg width="800" height="500" viewBox="0 0 800 500" fill="none" xmlns="http://www.w3.org/2000/svg">
  <!-- Dashboard Background -->
  <rect width="800" height="500" rx="10" fill="#1A2233" />
  
  <!-- Header -->
  <rect width="800" height="60" rx="10" fill="#0F2847" />
  <circle cx="40" cy="30" r="20" fill="#00B4D8" />
  <rect x="70" y="20" width="120" height="20" rx="5" fill="#FFFFFF" opacity="0.9" />
  <rect x="650" y="20" width="120" height="20" rx="5" fill="#FFFFFF" opacity="0.2" />
  
  <!-- Sidebar -->
  <rect width="60" height="440" y="60" fill="#0F2847" />
  <circle cx="30" cy="100" r="15" fill="#FFFFFF" opacity="0.2" />
  <circle cx="30" cy="150" r="15" fill="#FFFFFF" opacity="0.2" />
  <circle cx="30" cy="200" r="15" fill="#FFFFFF" opacity="0.2" />
  <circle cx="30" cy="250" r="15" fill="#FFFFFF" opacity="0.2" />
  <circle cx="30" cy="300" r="15" fill="#FFFFFF" opacity="0.2" />
  
  <!-- Main Chart -->
  <rect x="80" y="80" width="450" height="250" rx="5" fill="#0A192F" />
  <polyline points="100,280 150,220 200,240 250,180 300,200 350,150 400,120 450,90 500,110" stroke="#00D4FF" stroke-width="3" fill="none" />
  <polyline points="100,280 150,220 200,240 250,180 300,200 350,150 400,120 450,90 500,110" stroke="#FFFFFF" stroke-width="1" stroke-opacity="0.1" fill="none" />
  
  <!-- Chart Overlay -->
  <rect x="80" y="80" width="450" height="250" rx="5" fill="url(#chartGradient)" opacity="0.2" />
  
  <!-- Chart Labels -->
  <rect x="80" y="340" width="450" height="30" rx="5" fill="#0A192F" />
  <rect x="100" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="160" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="220" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="280" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="340" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="400" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="460" y="350" width="40" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  
  <!-- Side Widgets -->
  <rect x="550" y="80" width="230" height="120" rx="5" fill="#0A192F" />
  <rect x="570" y="100" width="190" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="570" y="120" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.3" />
  <rect x="570" y="140" width="190" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="570" y="160" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.3" />
  
  <rect x="550" y="220" width="230" height="150" rx="5" fill="#0A192F" />
  <circle cx="580" cy="250" r="10" fill="#00B4D8" />
  <rect x="600" y="245" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.7" />
  
  <circle cx="580" cy="280" r="10" fill="#4CAF50" />
  <rect x="600" y="275" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.7" />
  
  <circle cx="580" cy="310" r="10" fill="#F44336" />
  <rect x="600" y="305" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.7" />
  
  <circle cx="580" cy="340" r="10" fill="#FFC107" />
  <rect x="600" y="335" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.7" />
  
  <!-- Bottom Widgets -->
  <rect x="80" y="390" width="215" height="90" rx="5" fill="#0A192F" />
  <rect x="100" y="410" width="175" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="100" y="430" width="140" height="10" rx="2" fill="#FFFFFF" opacity="0.3" />
  <rect x="100" y="450" width="175" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  
  <rect x="315" y="390" width="215" height="90" rx="5" fill="#0A192F" />
  <rect x="335" y="410" width="175" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="335" y="430" width="140" height="10" rx="2" fill="#FFFFFF" opacity="0.3" />
  <rect x="335" y="450" width="175" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  
  <rect x="550" y="390" width="230" height="90" rx="5" fill="#0A192F" />
  <rect x="570" y="410" width="190" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  <rect x="570" y="430" width="150" height="10" rx="2" fill="#FFFFFF" opacity="0.3" />
  <rect x="570" y="450" width="190" height="10" rx="2" fill="#FFFFFF" opacity="0.5" />
  
  <!-- Gradients -->
  <defs>
    <linearGradient id="chartGradient" x1="80" y1="80" x2="80" y2="330" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#00D4FF" stop-opacity="0.5" />
      <stop offset="1" stop-color="#00D4FF" stop-opacity="0" />
    </linearGradient>
  </defs>
</svg>